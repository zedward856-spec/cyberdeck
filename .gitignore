# secrets - never publish
**/fast.bin
*.key
*.pem
id_ed25519*
id_rsa*
# build artifacts / backups
*.pre-*
*.bak-*
*.disabled
cyberterm/cyberterm
*.o

# android signing keystore - never publish
*.jks
*.keystore
# esp build artifacts (keep only .bin)
esp-dashboard/build/*.elf
esp-dashboard/build/*.map

# cardputer local secrets (WiFi pass + control token)
cardputer-control/config.h

# esp8266 dashboard control token
esp-dashboard/deckdash_config.h
