#!/bin/sh

set -u

# Qt does not follow GTK scaling or theming; see ~/.xsessionrc
export QT_SCALE_FACTOR=2
export QT_QPA_PLATFORMTHEME=gtk3

MODE_FILE="$HOME/.config/cyberdeck/boot-mode"
mode=desktop
if [ -r "$MODE_FILE" ]; then
    mode=$(sed -n '1p' "$MODE_FILE")
fi

if [ "$mode" != cli ]; then
    exec /usr/bin/startxfce4
fi

/usr/bin/xset s off
/usr/bin/xset s noblank
/usr/bin/xset -dpms
/usr/bin/xsetroot -solid '#000000'

/usr/bin/xfwm4 --compositor=off >/dev/null 2>&1 &
sleep 0.25

exec /usr/bin/alacritty \
    --working-directory "$HOME" \
    --title 'Kali Cyberdeck CLI' \
    --option 'window.startup_mode="Fullscreen"' \
    --option 'window.decorations="None"' \
    --option 'font.size=28.0' \
    --option 'colors.primary.background="#000000"' \
    --option 'colors.primary.foreground="#ffffff"'
