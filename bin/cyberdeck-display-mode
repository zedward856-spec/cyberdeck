#!/bin/sh
set -eu

attempt=0
while [ "$attempt" -lt 60 ]; do
    if DISPLAY=:0 XAUTHORITY=/var/run/lightdm/root/:0 \
        /usr/bin/xrandr --output HDMI-1 --mode 1920x1080 >/dev/null 2>&1; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done

echo "Unable to set HDMI-1 to 1920x1080" >&2
exit 1
