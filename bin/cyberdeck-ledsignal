#!/bin/sh
# Borrow the Pi ACT LED for a sine-breathing signal, then hand it straight back
# to the mmc0 trigger so it resumes showing SD read/write activity.
#   usage: cyberdeck-ledsignal [cycles] [period_seconds]
set -u
LED=/sys/class/leds/ACT
RESTORE=mmc0
CYCLES=${1:-3}
PERIOD=${2:-2.0}

echo none > "$LED/trigger" 2>/dev/null
/usr/local/bin/cyberdeck-ledwave "$LED/brightness" "$CYCLES" "$PERIOD" 4000 2.2
echo 0 > "$LED/brightness" 2>/dev/null
echo "$RESTORE" > "$LED/trigger" 2>/dev/null
