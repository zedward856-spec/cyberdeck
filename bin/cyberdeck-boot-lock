#!/bin/sh
# Lock the screen as soon as the session comes up.
#
# With autologin enabled (93-cyberdeck-autologin.conf) the session starts
# unattended at boot, so THIS - not the greeter - is what stands between a cold
# boot and the desktop. A lock that silently fails would leave the deck open on
# the phone, so this retries and reports rather than firing once and hoping.

LOGF=/tmp/cyberdeck-boot-lock.log
tag() {
    logger -t cyberdeck-boot-lock "$@" 2>/dev/null
    echo "$(date '+%F %T') $*" >> "$LOGF" 2>/dev/null
}

# NEVER pgrep for this process. "xfce4-screensaver" is 17 characters and the
# kernel comm name is capped at 15, so `pgrep -x xfce4-screensaver` can never
# match - it fails loudly on newer procps and silently on older ones. Ask the
# screensaver itself; it is the authoritative answer anyway.
ss_state() { xfce4-screensaver-command -q 2>&1 | head -1; }
running()  { case "$(ss_state)" in *"not running"*) return 1 ;; *) return 0 ;; esac; }
locked()   { case "$(ss_state)" in *"is active"*)   return 0 ;; *) return 1 ;; esac; }

tag "starting; initial state: $(ss_state)"

# The screensaver's own autostart entry is disabled on this box, so waiting for
# the session to bring it up is waiting for something that will never happen -
# and every second spent waiting is a second the desktop is visible on the
# phone. Start it immediately instead.
if ! running; then
    tag "screensaver not up - starting it immediately"
    setsid xfce4-screensaver >/dev/null 2>&1 &
    j=0
    while [ "$j" -lt 40 ]; do
        running && break
        sleep 0.5
        j=$(( j + 1 ))
    done
fi

running || { tag "FAILED - screensaver will not start, cannot lock"; exit 1; }

# Retry until it reports active: --lock exiting 0 is not proof that it engaged.
# timeout, because --lock can sit waiting on the session bus.
i=0
while [ "$i" -lt 20 ]; do
    if locked; then
        tag "screen locked at boot after ${i}s"
        exit 0
    fi
    timeout 5 xfce4-screensaver-command --lock >/dev/null 2>&1
    sleep 1
    i=$(( i + 1 ))
done

tag "FAILED TO LOCK AT BOOT - desktop is exposed on the display"
exit 1
