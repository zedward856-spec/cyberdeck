#!/usr/bin/env python3
"""Cyberdeck boot splash - cyberpunk HUD.

The deck's display is the Nexus 5 over VNC, which can only show anything once
X exists (~19s into a 24s boot). So this does not fake a 0->100 sweep: it
appears already partly filled (uptime vs a self-calibrating total) and runs to
100% through session startup - the part you actually sit and wait through.

Safety: it can never wedge the display. It exits on the desktop appearing, on
any keypress, or on a hard timeout - whichever comes first.

All telemetry on screen is real: temperature, clock, memory and unit counts are
read from /sys and /proc; the node id is the machine-id.
"""
import os, sys, time, random, subprocess, tkinter as tk

CAL       = "/var/lib/cyberdeck/ready-secs"
FLOOR     = 62.0         # where the bar starts: X is up, so boot is well along
DEFAULT   = 25.0
MAX_SECS  = 14.0        # visible seconds, counted only once the viewer is connected
HARD_MAX  = 50.0        # absolute ceiling regardless of anything
BOOT_MAX  = 120.0
DEMO_SECS = 0.0

BG      = "#05080c"
KALI    = "#367BF0"     # Kali blue - the primary
CYAN    = "#22d3ee"
MAGENTA = "#ff2e88"
FG      = "#e8f1fa"
DIM     = "#3d5468"
GRID    = "#0b1219"
SCAN    = "#080d13"
TRACK   = "#111c26"

SEGMENTS = 56
CORPTA   = "Corpta DEMO"     # display face: letters and spaces ONLY
NUMERAL  = "Chakra Petch"    # companion face for anything with digits


def _read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return default


def uptime():
    try:
        return float(_read("/proc/uptime", "0").split()[0])
    except Exception:
        return 0.0


def expected():
    try:
        v = float(_read(CAL))
        if 5.0 < v < 300.0:
            return v
    except Exception:
        pass
    return DEFAULT


def _pgrep(*a):
    return subprocess.call(["pgrep", *a], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL) == 0


def desktop_up():
    return _pgrep("-u", "kali", "-x", "xfce4-session")


def greeter_up():
    return _pgrep("-f", "lightdm-gtk-greeter")


def viewer_connected():
    """Is the Nexus 5 actually displaying us yet?

    The splash paints on X the moment lightdm starts, but cyberdeck-adb and the
    AVNC viewer connect a few seconds later - so without this the whole splash
    can come and go before the phone's screen exists. Nothing counts down until
    someone is watching."""
    try:
        out = subprocess.check_output(["ss", "-tn", "state", "established"],
                                      text=True, stderr=subprocess.DEVNULL)
        return ":5901" in out
    except Exception:
        return True   # can't tell - assume watched rather than hang


def stage():
    if desktop_up():
        return "SESSION ESTABLISHED"
    if greeter_up():
        return "AWAITING CREDENTIAL   TAP CARD"
    return "BRINGING UP SERVICES"


def telemetry():
    t = _read("/sys/class/thermal/thermal_zone0/temp", "0")
    try:
        temp = "%.1fC" % (int(t) / 1000.0)
    except Exception:
        temp = "--"
    f = _read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq", "0")
    try:
        freq = "%dMHz" % (int(f) // 1000)
    except Exception:
        freq = "--"
    mt = ma = 0
    for line in _read("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            mt = int(line.split()[1])
        elif line.startswith("MemAvailable:"):
            ma = int(line.split()[1])
    mem = "%dM/%dM" % ((mt - ma) // 1024, mt // 1024) if mt else "--"
    return temp, freq, mem


class Splash:
    def __init__(self, root):
        self.root = root
        self.start = time.time()
        self.t0 = uptime()
        exp = expected()
        # how long we still expect to wait; never less than 4s so the ramp is visible
        self.window = max(4.0, exp - self.t0) if exp > self.t0 else 9.0
        self.done_at = None
        self.viewer_at = None
        self.frame = 0
        self.tele = ("--", "--", "--")
        self.tele_at = 0.0

        root.configure(bg=BG)
        root.attributes("-fullscreen", True)
        root.attributes("-topmost", True)
        root.config(cursor="none")
        for seq in ("<Key>", "<Button-1>"):
            root.bind(seq, lambda e: self.finish())

        w, h = root.winfo_screenwidth(), root.winfo_screenheight()
        self.w, self.h = w, h
        c = tk.Canvas(root, width=w, height=h, bg=BG, highlightthickness=0)
        c.pack()
        self.c = c
        cx, cy = w // 2, h // 2

        # ---- background grid ----
        for x in range(0, w, 64):
            c.create_line(x, 0, x, h, fill=GRID)
        for y in range(0, h, 64):
            c.create_line(0, y, w, y, fill=GRID)

        # ---- HUD corner brackets ----
        m, L = 54, 90
        for (ax, ay, dx, dy) in ((m, m, 1, 1), (w - m, m, -1, 1),
                                 (m, h - m, 1, -1), (w - m, h - m, -1, -1)):
            c.create_line(ax, ay, ax + dx * L, ay, fill=CYAN, width=3)
            c.create_line(ax, ay, ax, ay + dy * L, fill=CYAN, width=3)
            c.create_line(ax + dx * 14, ay + dy * 26, ax + dx * 14,
                          ay + dy * 60, fill=MAGENTA, width=2)

        # ---- header: real machine identity ----
        node = _read("/etc/hostname", "cyberdeck")
        mid = _read("/etc/machine-id", "00000000")[:8].upper()
        kern = os.uname().release
        c.create_text(m + 8, m + 40, anchor="w",
                      text="NODE %s      ID %s      KERNEL %s" % (node, mid, kern),
                      fill=DIM, font=("DejaVu Sans Mono", 15))
        c.create_text(w - m - 8, m + 40, anchor="e", text="KALI ARM",
                      fill=MAGENTA, font=(CORPTA, 19))

        # ---- title with chromatic aberration ----
        ty = cy - 200
        self.t_m = c.create_text(cx - 4, ty, text="C Y B E R D E C K",
                                 fill=MAGENTA, font=(CORPTA, 62))
        self.t_c = c.create_text(cx + 4, ty, text="C Y B E R D E C K",
                                 fill=CYAN, font=(CORPTA, 62))
        self.t_w = c.create_text(cx, ty, text="C Y B E R D E C K",
                                 fill=FG, font=(CORPTA, 62))
        c.create_text(cx, ty + 66, text="S Y S T E M   B O O T",
                      fill=DIM, font=(CORPTA, 22))

        # ---- segmented progress bar ----
        self.bw = int(w * 0.62)
        self.bh = 34
        self.bx = cx - self.bw // 2
        self.by = cy + 10
        gap = 3
        seg_w = (self.bw - gap * (SEGMENTS - 1)) / SEGMENTS
        self.segs = []
        for i in range(SEGMENTS):
            x0 = self.bx + i * (seg_w + gap)
            self.segs.append(c.create_rectangle(x0, self.by, x0 + seg_w,
                                                self.by + self.bh,
                                                fill=TRACK, outline=""))
        c.create_rectangle(self.bx - 10, self.by - 10, self.bx + self.bw + 10,
                           self.by + self.bh + 10, outline=DIM, width=1)
        # end caps
        c.create_line(self.bx - 22, self.by, self.bx - 22, self.by + self.bh,
                      fill=CYAN, width=3)
        c.create_line(self.bx + self.bw + 22, self.by, self.bx + self.bw + 22,
                      self.by + self.bh, fill=CYAN, width=3)

        # ---- percentage (chromatic shadow) ----
        py = cy + 135
        self.p_m = c.create_text(cx + 3, py + 2, text="0%", fill=MAGENTA,
                                 font=(NUMERAL, 82, "bold"))
        self.p_t = c.create_text(cx, py, text="0%", fill=KALI,
                                 font=(NUMERAL, 82, "bold"))

        # ---- status line + blinking cursor ----
        self.sy = cy + 215
        self.s_t = c.create_text(cx, self.sy, text="", fill=CYAN,
                                 font=(CORPTA, 26))
        self.cur = c.create_rectangle(0, 0, 0, 0, fill=CYAN, outline="")

        # ---- telemetry row ----
        self.tl_t = c.create_text(cx, cy + 285, text="", fill=DIM,
                                  font=(NUMERAL, 22, "bold"))

        # ---- scanlines, drawn last so they sit over everything ----
        for y in range(0, h, 4):
            c.create_line(0, y, w, y, fill=SCAN)

        c.create_text(cx, h - 62, text="PRESS ANY KEY TO DISMISS",
                      fill=DIM, font=(CORPTA, 17))
        self.tick()

    def finish(self):
        try:
            self.root.destroy()
        except Exception:
            pass

    def _paint(self, pct, label):
        c = self.c
        lit = int(SEGMENTS * pct / 100.0)
        for i, s in enumerate(self.segs):
            if i < lit - 1:
                c.itemconfig(s, fill=KALI)
            elif i == lit - 1:
                c.itemconfig(s, fill=CYAN)          # bright leading edge
            else:
                c.itemconfig(s, fill=TRACK)
        txt = "%d%%" % int(pct)
        c.itemconfig(self.p_t, text=txt)
        c.itemconfig(self.p_m, text=txt)
        c.itemconfig(self.s_t, text=label)

        # blinking block cursor after the status text
        bb = c.bbox(self.s_t)
        if bb and (self.frame // 4) % 2 == 0:
            c.coords(self.cur, bb[2] + 10, bb[1] + 3, bb[2] + 24, bb[3] - 3)
        else:
            c.coords(self.cur, 0, 0, 0, 0)

        # occasional chromatic glitch on the title
        if random.random() < 0.06:
            j = random.randint(-9, 9)
            c.coords(self.t_m, self.w // 2 - 4 + j, self.c.coords(self.t_w)[1])
            c.coords(self.t_c, self.w // 2 + 4 - j, self.c.coords(self.t_w)[1])
        elif self.frame % 5 == 0:
            y = self.c.coords(self.t_w)[1]
            c.coords(self.t_m, self.w // 2 - 4, y)
            c.coords(self.t_c, self.w // 2 + 4, y)

        now = time.time()
        if now - self.tele_at > 0.5:
            self.tele = telemetry()
            self.tele_at = now
        t, f, m = self.tele
        c.itemconfig(self.tl_t,
                     text="TEMP %s     CLK %s     MEM %s     T+%05.1fs"
                          % (t, f, m, uptime()))

    def tick(self):
        self.frame += 1
        up = uptime()
        alive = time.time() - self.start

        if DEMO_SECS > 0:
            pct = min(100.0, alive / DEMO_SECS * 100.0)
            self._paint(pct, "DEMO   BRINGING UP SERVICES")
            if pct >= 100.0:
                return self.root.after(900, self.finish)
            return self.root.after(90, self.tick)

        if desktop_up():
            pct = 100.0
            if self.done_at is None:
                self.done_at = time.time()
                try:
                    os.makedirs(os.path.dirname(CAL), exist_ok=True)
                    with open(CAL, "w") as f:
                        f.write("%.2f" % up)
                except Exception:
                    pass
        else:
            pct = min(99.0, FLOOR + (100.0 - FLOOR) * (alive / self.window))

        self._paint(pct, stage())

        # Nothing counts down until the phone's viewer is actually connected.
        now = time.time()
        if self.viewer_at is None and viewer_connected():
            self.viewer_at = now
        visible = 0.0 if self.viewer_at is None else now - self.viewer_at

        if self.done_at and (now - self.done_at) > 1.2 and visible > 2.5:
            return self.finish()
        # greeter up with no session: autologin is not happening, get out of the
        # way - but only after it has actually been seen
        if greeter_up() and not desktop_up() and visible > 6.0:
            return self.finish()
        if visible > MAX_SECS or alive > HARD_MAX:
            return self.finish()
        self.root.after(120, self.tick)


def main():
    global DEMO_SECS
    test = "--test" in sys.argv
    for i, a in enumerate(sys.argv):
        if a == "--demo" and i + 1 < len(sys.argv):
            DEMO_SECS = float(sys.argv[i + 1])
            test = True
    if not test and uptime() > BOOT_MAX:
        return 0
    root = tk.Tk()
    Splash(root)
    root.mainloop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
